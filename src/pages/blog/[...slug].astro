---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="container">
    <article class="post">
      <header class="post-header">
        <span class="pill pill-accent">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.data.author}</span>
        </div>
      </header>

      <div class="post-body">
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => <span class="pill">{tag}</span>)}
          </div>
        )
      }

      <p class="page-lede" style="margin-top:32px">
        <a href={base}>← Back to all articles</a>
      </p>

      <div class="oo-box" style="margin-top:24px;padding:16px;border:1px solid #ddd;border-radius:8px">
        <h2>About OnlyOrders</h2>
        <p>OnlyOrders turns DMs and comments into confirmed orders with smart replies, catalog checks, payment verification, and courier handoff — all from one inbox. <a href={`${base}onlyorders/`}>Read about OnlyOrders</a>.</p>
      </div>
    </article>
  </div>
</BaseLayout>
